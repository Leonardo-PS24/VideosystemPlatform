@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div class="text-center mb-4">
    <div class="d-inline-flex align-items-center justify-content-center  text-white rounded-circle mb-3" style="width: 64px; height: 64px;">
       <img src="~/images/logo-azienda.png" alt="Logo Videosystem" style=" height: 100%"/>
    </div>
    <h2 class="fw-bold text-primary">Videosystem</h2>
    <p class="text-secondary">Accedi alla piattaforma aziendale</p>
</div>

<form asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Username" class="form-label fw-bold text-secondary">Utente</label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0">
                <span class="material-icons text-secondary" style="font-size: 20px;">person</span>
            </span>
            <input asp-for="Username" class="form-control border-start-0 ps-0" placeholder="Inserisci username" autofocus />
        </div>
        <span asp-validation-for="Username" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Password" class="form-label fw-bold text-secondary">Password</label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0">
                <span class="material-icons text-secondary" style="font-size: 20px;">lock</span>
            </span>
            <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="Inserisci password" />
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label text-secondary">Ricordami</label>
        </div>
        <a href="#" class="text-decoration-none small text-primary">Password dimenticata?</a>
    </div>

    <div class="d-grid">
        <button type="submit" class="btn btn-primary btn-lg">
            ACCEDI
        </button>
    </div>
</form>

<div class="text-center my-3">
    <span class="text-muted small">oppure</span>
</div>

<form asp-action="ExternalLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
    <input type="hidden" name="provider" value="Google" />
    <button type="submit" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2 py-2 fw-semibold">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-google" viewBox="0 0 16 16">
          <path d="M15.545 6.558a9.42 9.42 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0c2.204 0 4.079.815 5.484 2.15l-2.617 2.617c-.753-.727-2.022-1.574-3.484-1.574-2.54 0-4.61 2.098-4.61 4.686 0 2.587 2.07 4.686 4.61 4.686 2.94 0 4.03-2.068 4.22-3.12H8V6.558h7.545z"/>
        </svg>
        Accedi con Google
    </button>
</form>

<form asp-action="ExternalLogin" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="mt-2">
    <input type="hidden" name="provider" value="Microsoft" />
    <button type="submit" class="btn btn-outline-dark w-100 d-flex align-items-center justify-content-center gap-2 py-2 fw-semibold">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 23 23">
            <path fill="#f25022" d="M1 1h10v10H1z" />
            <path fill="#7fba00" d="M12 1h10v10H12z" />
            <path fill="#00a4ef" d="M1 12h10v10H1z" />
            <path fill="#ffb900" d="M12 12h10v10H12z" />
        </svg>
        Accedi con Microsoft
    </button>
</form>

<div class="text-center mt-4 pt-3 border-top">
    <small class="text-muted">© @DateTime.Now.Year Videosystem S.r.l.</small>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
